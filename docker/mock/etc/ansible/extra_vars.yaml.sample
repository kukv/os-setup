---
# Copy to docker/mock/etc/ansible/extra_vars.yaml before running the mock container.
# Contains no real secrets.

# GitHub token to avoid GitHub API rate limits during provisioning (mise, etc.)
github_token: "your_github_token_here"

# systemd-timer OnCalendar expression for the provisioning schedule.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.time.html
provisioning_schedule: "weekly"

# Git identity (nested form; flows into chezmoi data -> ~/.gitconfig)
git:
  user:
    name: "username"
    email: "test@example.com"
  use_1password: true
