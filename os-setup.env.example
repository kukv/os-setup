# macOS only. Secret values loaded as environment variables at ansible-pull time.
# Place at ~/.local/etc/os-setup.env and `chmod 0600` it.
#
# The ansible-pull wrapper (~/.local/bin/os-setup-pull.sh) exports these via
# `set -a; source ...; set +a`, so they reach mise/Homebrew through the
# environment rather than Ansible's `--extra-vars` (avoiding ps/argv exposure).
#
# To run ansible-pull manually, source it first:
#   set -a; source ~/.local/etc/os-setup.env; set +a
#   ansible-pull ...

# GitHub Personal Access Token
# - mise pulls many tools from GitHub Releases; raises API rate limits
# - also reused for Homebrew API rate limits (HOMEBREW_GITHUB_API_TOKEN)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HOMEBREW_GITHUB_API_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
