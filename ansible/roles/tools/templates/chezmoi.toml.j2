# Managed by Ansible (os-setup). Seeds chezmoi data for non-interactive apply.
[data]
    git_name = "{{ git.user.name }}"
    git_email = "{{ git.user.email }}"
    use_1password = {{ 'true' if (git.use_1password | default(true)) else 'false' }}
{% if (git.signing_key_file | default('')) | length > 0 %}
    git_signing_key_file = "{{ git.signing_key_file }}"
{% endif %}
