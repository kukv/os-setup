#!/bin/zsh
set -euo pipefail
# {{ ansible_managed }}
# ansible-pull のラッパー。GITHUB_TOKEN 等の機密を ps/argv に露出させずに渡すため、
# 環境変数ファイルを source してから ansible-pull を exec する。

# ~/.local/bin を PATH に追加。
# claude 等のツールがここにインストールされるため、ansible タスクの
# `which claude` 等で正しく検出されないと毎回再インストールが走ってしまう。
export PATH="${HOME}/.local/bin:${PATH}"

# 日付付きログファイルに出力をリダイレクトする。
# launchd の固定名 StandardOutPath に任せると単一ファイルへ追記され続け、
# mtime が毎回更新されるため log_rotation.sh の `-mtime +N -delete` が
# 永久に発火しない。実行日ごとに別ファイルへ書き出すことで、古いログが
# 保持期間を過ぎて自然に削除されるようになる。
LOG_DIR="{{ scheduled.log_dir }}"
mkdir -p "${LOG_DIR}"
_log_date="$(date +%Y%m%d)"
exec >>"${LOG_DIR}/os-setup-${_log_date}.log" 2>>"${LOG_DIR}/os-setup-${_log_date}.error.log"

ENV_FILE="${HOME}/.local/etc/os-setup.env"
EXTRA_VARS_FILE="${HOME}/.local/etc/extra_vars.yaml"

if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
fi

ARGS=(
  --url "{{ scheduled.repo_url }}"
  --checkout "{{ scheduled.branch }}"
  --inventory ansible/inventories/hosts.yaml
  --limit localhost
)

if [[ -f "${EXTRA_VARS_FILE}" ]]; then
  ARGS+=(--extra-vars "@${EXTRA_VARS_FILE}")
fi

ARGS+=(ansible/playbook.yaml)

exec /opt/homebrew/bin/ansible-pull "${ARGS[@]}"
